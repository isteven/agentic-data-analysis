# ============================================================================
# Backend (FastAPI) - environment configuration
# Copy this file to backend/.env and fill in real values. Never commit .env.
# ============================================================================

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
# Used by the backend/worker inside Docker Compose (service name "db")
DATABASE_URL=postgresql+asyncpg://apda:apda@db:5432/apda
# Used by Alembic / local scripts run outside Docker (points at localhost)
DATABASE_URL_LOCAL=postgresql+asyncpg://apda:apda@localhost:5432/apda

# --- Redis (SAQ task queue + WebSocket trace pub/sub) ---
REDIS_URL=redis://redis:6379/0

# --- LLM Providers ---
# At least OpenAI is required. Bedrock is optional (see LLM_ENABLE_BEDROCK).
LLM_DEFAULT_PROVIDER=openai
LLM_FALLBACK_PROVIDER=bedrock
# 0 = repeatable answers (recommended); higher values make output more varied
LLM_TEMPERATURE=0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_QUALITY=gpt-4o

# AWS Bedrock (optional for local dev - set LLM_ENABLE_BEDROCK=false to skip)
LLM_ENABLE_BEDROCK=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID_FAST=
BEDROCK_MODEL_ID_QUALITY=

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_QUERIES_PER_MINUTE=10
